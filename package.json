{
  "name": "pidp11-web-desktop",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "build": "tsc --noEmit && vite build && node scripts/standalone.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "build:server": "npm run build && node scripts/embed-assets.mjs",
    "test:integration": "node --test integration/*.test.ts",
    "test:browser": "playwright test",
    "test:browser-soak": "node scripts/browser-soak.mjs",
    "test:replicant": "node --test integrations/hacker-replicant/read-only.test.mjs",
    "preinstall": "node scripts/check-prerequisites.mjs",
    "predev": "node scripts/check-prerequisites.mjs --dependencies",
    "doctor": "node scripts/check-prerequisites.mjs --dependencies",
    "test:selection-contract": "node --test integrations/selection-contract/*.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0"
  }
}
